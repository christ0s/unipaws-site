# UniPaws Static Website - Cloudflare Pages Redirects
# https://developers.cloudflare.com/pages/configuration/redirects

# Default page routing (Cloudflare handles this automatically for static sites)
# Clean URLs - remove .html extension

/about    /about.html    200
/privacy  /privacy.html  200
/terms    /terms.html    200

# Handle trailing slashes
/about/    /about.html    200
/privacy/  /privacy.html  200
/terms/    /terms.html    200

# Redirect common variations
/privacy-policy    /privacy.html    301
/terms-of-service  /terms.html      301
/tos               /terms.html      301
/contact           /about.html#contact  301

